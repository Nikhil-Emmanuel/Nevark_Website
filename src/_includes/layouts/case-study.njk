---
layout: layouts/base.njk
---
{%- set related = collections.projects | bySlugs(related) -%}
{%- set parent = (collections.projects | bySlugs([partOf]))[0] if partOf -%}
{%- set accents = ["text-red-400", "text-indigo-300", "text-amber-300"] -%}

<article>
  <header class="relative px-6 pt-36 md:pt-44 pb-10">
    <div class="absolute top-24 left-1/2 -translate-x-1/2 w-[560px] max-w-full h-[420px] bg-indigo-600/20 blur-[110px] rounded-full pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-5xl mx-auto">
      <nav aria-label="Breadcrumb" class="text-xs text-gray-400">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-white">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/projects" class="hover:text-white">Projects</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-gray-200">{{ title }}</li>
        </ol>
      </nav>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        {% include "partials/status-badge.njk" %}
        <span class="eyebrow">{{ industry }}</span>
        {%- if release %}<span class="eyebrow">Release {{ release }}</span>{% endif %}
      </div>

      <div class="mt-6 flex items-center gap-4 md:gap-5">
        {%- if logo %}<img src="{{ logo }}" alt="" class="w-14 h-14 md:w-16 md:h-16 shrink-0 rounded-2xl object-contain bg-white/5 ring-1 ring-white/10" loading="eager" eleventy:widths="128" sizes="64px">{% endif %}
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight leading-[1.05] text-white">{{ title }}</h1>
      </div>
      {%- if fullTitle %}<p class="mt-4 text-lg md:text-xl text-gray-300">{{ fullTitle }}</p>{% endif %}
      <p class="mt-6 max-w-3xl text-base md:text-lg text-gray-400 leading-relaxed">{{ summary }}</p>

      {%- if parent %}
      <p class="mt-6 text-sm text-gray-400">Part of the <a href="{{ parent.url }}" class="text-brand-400 underline underline-offset-4 hover:text-white">{{ parent.data.title }}</a> ecosystem.</p>
      {%- endif %}

      <dl class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 text-sm">
        <div class="bg-black/60 p-4 md:p-5"><dt class="text-gray-400 text-xs uppercase tracking-wider">Industry</dt><dd class="mt-1 text-white">{{ industry }}</dd></div>
        <div class="bg-black/60 p-4 md:p-5"><dt class="text-gray-400 text-xs uppercase tracking-wider">Released</dt><dd class="mt-1 text-white"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></dd></div>
        <div class="bg-black/60 p-4 md:p-5"><dt class="text-gray-400 text-xs uppercase tracking-wider">Status</dt><dd class="mt-1 text-white">{{ status }}</dd></div>
        {%- if client %}
        <div class="bg-black/60 p-4 md:p-5"><dt class="text-gray-400 text-xs uppercase tracking-wider">Client</dt><dd class="mt-1 text-white">{{ client }}</dd></div>
        {%- elif kind == "product" %}
        <div class="bg-black/60 p-4 md:p-5"><dt class="text-gray-400 text-xs uppercase tracking-wider">Built by</dt><dd class="mt-1 text-white">Nevark <span class="text-gray-400">(in-house product)</span></dd></div>
        {%- else %}
        <div class="bg-black/60 p-4 md:p-5"><dt class="text-gray-400 text-xs uppercase tracking-wider">Version</dt><dd class="mt-1 text-white">{{ release }}</dd></div>
        {%- endif %}
      </dl>
    </div>
  </header>

  <div class="px-6">
    <figure class="max-w-5xl mx-auto card overflow-hidden {% if coverBg == 'light' %}!bg-white p-4 md:p-8{% elif coverFit == 'contain' %}p-8 md:p-12 bg-gradient-to-br from-indigo-500/10 to-purple-500/5{% endif %}">
      <img src="{{ cover }}" alt="{{ coverAlt }}" class="w-full {{ 'max-h-[560px] object-contain' if coverFit == 'contain' else 'h-auto object-cover' }}" loading="eager" fetchpriority="high" sizes="(min-width: 1024px) 1024px, 100vw" eleventy:widths="640,1024,1600">
    </figure>
  </div>

  <div class="px-6 py-16 md:py-24">
    <div class="max-w-5xl mx-auto grid gap-6 md:grid-cols-3">
      {%- for s in sections %}
      <section class="card p-7 md:p-8 reveal" aria-labelledby="sec-{{ loop.index }}">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] {{ accents[loop.index0 % 3] }}">{{ s.label }}</p>
        <h2 id="sec-{{ loop.index }}" class="mt-3 text-xl font-semibold text-white leading-snug">{{ s.heading }}</h2>
        <p class="mt-4 text-sm md:text-[15px] text-gray-300 leading-relaxed">{{ s.text }}</p>
      </section>
      {%- endfor %}
    </div>

    {%- if outcomes and outcomes.length %}
    <section class="max-w-5xl mx-auto mt-16" aria-labelledby="impact">
      <h2 id="impact" class="section-title">Impact</h2>
      <dl class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {%- for o in outcomes %}
        <div class="card gradient-border p-6 reveal"><dt class="text-sm text-gray-400">{{ o.label }}</dt><dd class="mt-2 text-3xl font-semibold text-white">{{ o.value }}</dd></div>
        {%- endfor %}
      </dl>
    </section>
    {%- endif %}

    {%- if gallery and gallery.length %}
    <section class="max-w-5xl mx-auto mt-16" aria-labelledby="gallery">
      <h2 id="gallery" class="section-title">Gallery</h2>
      <div class="mt-8 grid gap-6 {{ 'sm:grid-cols-3' if gallery.length >= 3 else 'sm:grid-cols-2' }}">
        {%- for g in gallery %}
        <figure class="card overflow-hidden reveal {% if g.wide %}sm:col-span-full bg-white{% else %}p-6 bg-gradient-to-br from-indigo-500/10 to-purple-500/5{% endif %}">
          <img src="{{ g.src }}" alt="{{ g.alt }}" class="w-full {{ 'h-auto' if g.wide else 'max-h-[520px] object-contain' }}" sizes="{{ '(min-width: 1024px) 1024px, 100vw' if g.wide else '(min-width: 640px) 33vw, 100vw' }}">
          {%- if g.caption %}<figcaption class="mt-4 text-center text-xs uppercase tracking-[0.18em] text-gray-400">{{ g.caption }}</figcaption>{% endif %}
        </figure>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    <section class="max-w-5xl mx-auto mt-16 grid gap-6 md:grid-cols-2" aria-label="Capabilities">
      <div class="card p-7 reveal">
        <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-gray-400">What we delivered</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {%- for s in deliverables %}<li class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-gray-200">{{ s }}</li>{% endfor %}
        </ul>
      </div>
      {%- if stack and stack.length %}
      <div class="card p-7 reveal">
        <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-gray-400">Technology</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {%- for s in stack %}<li class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-gray-200">{{ s }}</li>{% endfor %}
        </ul>
      </div>
      {%- endif %}
    </section>

    <p class="max-w-5xl mx-auto mt-10 text-xs text-gray-500">All project concepts, designs, and implementations are proprietary and the sole property of {{ site.legalName }}.</p>
  </div>
</article>

{%- if related.length %}
<section class="px-6 pb-8" aria-labelledby="related">
  <div class="max-w-5xl mx-auto">
    <h2 id="related" class="section-title">Related work</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {%- for p in related %}{% include "partials/project-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- set ctaTitle = "Have a similar challenge?" %}
{%- set ctaText = "Tell us about your operation. We'll show you what intelligent, real-time systems could do for it." %}
{% include "partials/cta.njk" %}

<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": title,
  "alternativeHeadline": fullTitle,
  "description": description,
  "datePublished": page.date | isoDate,
  "image": ogImage | absoluteUrl(site.url),
  "url": page.url | absoluteUrl(site.url),
  "creator": { "@id": site.url + "/#organization" },
  "about": industry,
  "version": release
} | json | safe }}</script>
