<section class="relative py-24 px-6 overflow-hidden" aria-labelledby="cta-title">
  <div class="absolute inset-0 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 opacity-20 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-3xl mx-auto text-center reveal">
    <h2 id="cta-title" class="section-title">{{ ctaTitle or "Ready to Accelerate Your Vision?" }}</h2>
    <p class="mt-5 text-neutral-200 max-w-2xl mx-auto">{{ ctaText or "Let's create value together. Book a complimentary strategy session with our leadership team now." }}</p>
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href="/bookmeeting" class="btn btn-primary">Schedule Now {% icon "arrow-right", "w-4 h-4" %}</a>
      <a href="/contact" class="btn btn-ghost">Contact Us</a>
    </div>
  </div>
</section>
