{#- expects `p` (a collection item) -#}
<article class="card card-hover group relative flex flex-col overflow-hidden reveal" data-industry="{{ p.data.industry | slugifyIndustry }}">
  <div class="relative aspect-[16/10] overflow-hidden {{ 'bg-white p-3' if p.data.coverBg == 'light' else 'bg-gradient-to-br from-white/5 to-white/0' }} {% if p.data.coverFit == 'contain' and p.data.coverBg != 'light' %}p-6{% endif %}">
    <img src="{{ p.data.cover }}" alt="{{ p.data.coverAlt }}" class="h-full w-full {{ 'object-contain' if p.data.coverFit == 'contain' else 'object-cover' }} transition-transform duration-700 group-hover:scale-105" sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw">
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-gray-400">
      {%- if p.data.kind == "product" %}Nevark Product · {% elif p.data.kind == "client" %}Client Work · {% endif %}{{ p.data.industry -}}
    </p>
    <h3 class="mt-3 text-xl font-semibold text-white">
      <a href="{{ p.url }}" class="after:absolute after:inset-0 focus-visible:outline-none">{{ p.data.title }}</a>
    </h3>
    <p class="mt-2 text-sm text-gray-300 leading-relaxed">{{ p.data.summary }}</p>
    <div class="mt-auto pt-6">
      <div class="flex items-center justify-between gap-3 border-t border-white/10 pt-4 text-xs text-gray-400">
        <span class="inline-flex items-center gap-2 whitespace-nowrap">{% set status = p.data.status %}{% include "partials/status-badge.njk" %}<span aria-hidden="true">·</span><span>{{ p.date | monthYear }}</span></span>
        <span class="inline-flex items-center gap-1.5 whitespace-nowrap font-medium text-brand-400 group-hover:text-white transition-colors">View Case Study {% icon "arrow-right", "w-3.5 h-3.5 transition-transform group-hover:translate-x-1" %}</span>
      </div>
    </div>
  </div>
</article>
