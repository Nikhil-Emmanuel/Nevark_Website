{%- set s = status | lower -%}
{%- if "deploy" in s %}{% set badge = "bg-emerald-500/15 text-emerald-300 border-emerald-400/30" %}{% set dot = "bg-emerald-400" %}
{%- elif "pilot" in s %}{% set badge = "bg-amber-500/15 text-amber-300 border-amber-400/30" %}{% set dot = "bg-amber-400" %}
{%- else %}{% set badge = "bg-sky-500/15 text-sky-300 border-sky-400/30" %}{% set dot = "bg-sky-400" %}{% endif -%}
<span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-medium {{ badge }}"><span class="status-dot {{ dot }}" aria-hidden="true"></span>{{ status }}</span>
