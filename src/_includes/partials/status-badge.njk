{#- Minimal status: a small coloured dot + plain text that inherits the surrounding type. Expects `status`. -#}
{%- set s = status | lower -%}
{%- if "deploy" in s %}{% set dot = "bg-emerald-400" %}
{%- elif "pilot" in s %}{% set dot = "bg-amber-400" %}
{%- else %}{% set dot = "bg-sky-400" %}{% endif -%}
<span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 shrink-0 rounded-full {{ dot }}" aria-hidden="true"></span>{{ status }}</span>
