  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^11.16.4",
    "lucide-static": "^1.59.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  }
